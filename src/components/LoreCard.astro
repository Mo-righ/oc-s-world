---
import { url } from '../lib/site';

interface Props {
  id: string;
  name: string;
  enName?: string;
  category?: string;
  icon?: string;
  accent?: string;
  tags?: string[];
  summary: string;
}

const {
  id,
  name,
  enName,
  category = '体系',
  icon = '⚙',
  accent = '#b6ff3c',
  tags = [],
  summary,
} = Astro.props;
---

<a
  href={url(`/settings/systems/${id}`)}
  class="panel corners hoverable group flex flex-col p-5"
  style={`--accent:${accent}`}
>
  <div class="flex items-center gap-3">
    <span
      class="grid h-10 w-10 shrink-0 place-items-center rounded-md border text-lg"
      style={`border-color:${accent}44;color:${accent};background:#0e0e18`}>{icon}</span
    >
    <div class="min-w-0">
      <h3 class="truncate text-[16px] font-bold text-ink transition-colors group-hover:text-[var(--accent)]">
        {name}
      </h3>
      <p class="truncate font-mono text-[10px] tracking-[0.18em] text-dust-2">{enName ?? category}</p>
    </div>
  </div>

  <p class="mt-3.5 line-clamp-3 text-[13.5px] leading-relaxed text-dust">{summary}</p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    <span class="chip" style={`color:${accent};border-color:${accent}44`}>{category}</span>
    {tags.slice(0, 2).map((t) => <span class="chip">{t}</span>)}
  </div>

  <div class="mt-auto flex items-center justify-end pt-4">
    <span
      class="font-mono text-[11px] text-dust-2 transition-all duration-300 group-hover:translate-x-1 group-hover:text-[var(--accent)]"
    >
      展开条目 →
    </span>
  </div>
</a>
