---
/**
 * 数据雨：低透明度、低帧率的字符流，铺在内容下方，只做氛围。
 * 纯 canvas，无外部依赖；尊重 prefers-reduced-motion（只画一帧）。
 */
---

<canvas class="data-rain" id="data-rain" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('data-rain') as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 只是「数据」的形状：十六进制 + 少量符号 + 极少数汉字
    const GLYPHS = '0123456789ABCDEF{}[]<>/\\|=+-*#%&_微光信标节点';
    const FONT_SIZE = 13;
    const FRAME_MS = 55; // ~18fps，足够，且很省电

    let cols = 0;
    let drops: number[] = [];
    let speeds: number[] = [];
    let dpr = 1;
    let w = 0;
    let h = 0;

    const setup = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = `${FONT_SIZE}px ui-monospace, SFMono-Regular, Menlo, monospace`;
      ctx.textBaseline = 'top';

      cols = Math.ceil(w / (FONT_SIZE * 1.15));
      drops = Array.from({ length: cols }, () => Math.random() * -h);
      speeds = Array.from({ length: cols }, () => 0.6 + Math.random() * 1.6);

      ctx.fillStyle = '#0a0a0f';
      ctx.fillRect(0, 0, w, h);
    };

    const drawOnce = () => {
      // 每一次「帧」：先蒙一层深色，制造拖尾
      ctx.fillStyle = 'rgba(10,10,15,0.085)';
      ctx.fillRect(0, 0, w, h);

      for (let i = 0; i < cols; i++) {
        const x = i * FONT_SIZE * 1.15;
        const y = drops[i];
        const ch = GLYPHS[(Math.random() * GLYPHS.length) | 0];

        // 头部字符亮一些，偶尔来个琥珀色的
        const head = Math.random() > 0.965;
        ctx.fillStyle = head ? 'rgba(255,176,32,0.85)' : 'rgba(0,229,255,0.55)';
        ctx.fillText(ch, x, y);

        // 尾部一点点残影，颜色更暗
        ctx.fillStyle = 'rgba(0,229,255,0.16)';
        ctx.fillText(GLYPHS[(Math.random() * GLYPHS.length) | 0], x, y - FONT_SIZE * 2);

        drops[i] += FONT_SIZE * speeds[i];
        if (drops[i] > h && Math.random() > 0.975) {
          drops[i] = -Math.random() * h * 0.4;
        }
      }
    };

    setup();

    if (reduced) {
      drawOnce();
      drawOnce();
    } else {
      let last = 0;
      let raf = 0;
      let visible = true;

      const loop = (t: number) => {
        if (!visible) return;
        if (t - last >= FRAME_MS) {
          last = t;
          drawOnce();
        }
        raf = requestAnimationFrame(loop);
      };
      raf = requestAnimationFrame(loop);

      // 后台标签页 / 滚出视野时不空转
      document.addEventListener('visibilitychange', () => {
        visible = !document.hidden;
        if (visible) raf = requestAnimationFrame(loop);
        else cancelAnimationFrame(raf);
      });

      let rt: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(rt);
        rt = window.setTimeout(setup, 220);
      });
    }
  }
</script>
