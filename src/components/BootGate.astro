---
/**
 * 开机认证界面 —— 「按任意键接入」
 * 只在首页出现；认证通过后写入 sessionStorage，本次会话内不再重复。
 * 也可以用右上角「跳过认证」直接进入。
 */
interface Props {
  name: string;
  mark: string;
  motto: string;
  prompt?: string;
  touchPrompt?: string;
  bootLines?: string[];
  footnotes?: string[];
  operator?: string;
  role?: string;
  clearance?: string;
  node?: string;
}

const {
  name,
  mark,
  motto,
  prompt = '按任意键进行身份认证',
  touchPrompt = '轻触屏幕任意位置以继续',
  bootLines = [],
  footnotes = [],
  operator = 'STARRY',
  role = '',
  clearance = '',
  node = 'NODE-07',
} = Astro.props;
---

<!-- 放在最前面：本次会话已认证过就直接隐藏，避免刷新时闪一下 -->
<script is:inline>
  (function () {
    var root = document.documentElement;
    try {
      if (sessionStorage.getItem('gl-gate-auth') === '1') {
        root.classList.add('gl-authed');
      } else {
        // 认证期间锁住页面滚动，避免在遮罩下面偷偷滑动
        root.classList.add('gl-locked');
      }
    } catch (e) {
      root.classList.add('gl-locked');
    }
  })();
</script>

<div class="gl-gate" id="gl-gate" role="dialog" aria-modal="true" aria-label="微光数据库身份认证">
  <!-- 底层装饰：点阵 + 扫描横纹 + 扫过竖线 -->
  <div class="gl-gate__grid" aria-hidden="true"></div>
  <div class="gl-gate__scan" aria-hidden="true"></div>
  <div class="gl-gate__vscan" aria-hidden="true"></div>

  <!-- 内框四角 -->
  <div class="gl-gate__frame" aria-hidden="true">
    <i></i><i></i><i></i><i></i>
  </div>

  <!-- 边角 HUD 读数 -->
  <div class="gl-gate__hud gl-gate__hud--tl" aria-hidden="true">
    <span>{node}</span>
    <span>SESSION <b id="gl-sid">····</b></span>
  </div>
  <div class="gl-gate__hud gl-gate__hud--bl" aria-hidden="true">
    <span>LAT 53.55N · LON 108.16E</span>
    <span>PROTOCOL GLIMMER/2.7</span>
  </div>
  <div class="gl-gate__hud gl-gate__hud--br" aria-hidden="true">
    <span>LOCAL TIME <b id="gl-gtime">--:--:--</b></span>
    <span>BUILD GL-2610</span>
  </div>

  <a class="gl-gate__skip" href="#main" id="gl-skip">跳过认证</a>

  <div class="gl-gate__inner">
    <!-- 标题区：背后套一组同心环与刻度，缓慢反向旋转 -->
    <div class="gl-gate__hero">
      <div class="gl-gate__reticle" aria-hidden="true">
        <i class="rt-r1"></i>
        <i class="rt-r2"></i>
        <i class="rt-r3"></i>
        <b class="rt-c1"></b><b class="rt-c2"></b><b class="rt-c3"></b><b class="rt-c4"></b>
      </div>

      <p class="gl-gate__mark">{mark}</p>
      <h1 class="gl-gate__title glitch gl-flicker" data-text={name}>{name}</h1>
      <p class="gl-gate__motto">{motto}</p>
    </div>

    <!-- 访问者身份 -->
    <div class="gl-gate__id">
      <span class="gl-gate__id-k">OPERATOR</span>
      <b class="gl-gate__id-n">{operator}</b>
      {role && <span class="gl-gate__id-role">{role}</span>}
      {clearance && <span class="gl-gate__id-clr">{clearance}</span>}
    </div>

    <div class="gl-gate__log" id="gl-log" aria-live="polite"></div>
    <p class="gl-gate__prompt" id="gl-prompt" data-touch={touchPrompt}>{prompt}</p>

    <!-- 底部进度条：等待时来回扫，认证时按行推进 -->
    <div class="gl-gate__meter">
      <span class="gl-gate__meter-bar" id="gl-meter-bar" aria-hidden="true"><i id="gl-meter"></i></span>
      <span class="gl-gate__meter-txt" id="gl-meter-txt" aria-hidden="true">AWAITING INPUT</span>
    </div>
  </div>

  {
    footnotes.length > 0 && (
      <div class="gl-gate__foot">
        {footnotes.map((f) => (
          <span>{f}</span>
        ))}
      </div>
    )
  }
</div>

<!-- 认证时逐行打出来的日志；放在隐藏容器里，脚本读取文本 -->
<div id="gl-lines" hidden>
  {bootLines.map((line) => <span data-line>{line}</span>)}
</div>

<script>
  const gate = document.getElementById('gl-gate') as HTMLElement | null;

  if (gate) {
    const root = document.documentElement;
    const log = document.getElementById('gl-log') as HTMLElement | null;
    const promptEl = document.getElementById('gl-prompt') as HTMLElement | null;
    const skip = document.getElementById('gl-skip') as HTMLElement | null;
    const meterBar = document.getElementById('gl-meter-bar') as HTMLElement | null;
    const meter = document.getElementById('gl-meter') as HTMLElement | null;
    const meterTxt = document.getElementById('gl-meter-txt') as HTMLElement | null;

    // 已认证：直接移除，连监听都不挂
    if (root.classList.contains('gl-authed')) {
      gate.remove();
    } else {
      const lines = Array.from(
        document.querySelectorAll<HTMLElement>('#gl-lines [data-line]')
      ).map((el) => el.textContent ?? '');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 触屏没有键盘，提示语要换掉，否则「按任意键」是死胡同
      const coarse = window.matchMedia('(pointer: coarse)').matches;
      const touchHint = promptEl?.dataset.touch;
      if (coarse && promptEl && touchHint) {
        promptEl.textContent = touchHint;
      }

      // 本次会话标识 + 本地时间，纯装饰，但让界面像真的有一台机器在跑
      const sid = document.getElementById('gl-sid');
      if (sid) {
        sid.textContent = Array.from({ length: 6 }, () =>
          '0123456789ABCDEF'[Math.floor(Math.random() * 16)]
        ).join('');
      }
      const gtime = document.getElementById('gl-gtime');
      if (gtime) {
        const p2 = (v: number) => String(v).padStart(2, '0');
        const t = new Date();
        gtime.textContent = `${p2(t.getHours())}:${p2(t.getMinutes())}:${p2(t.getSeconds())}`;
      }

      let started = false;
      let done = false;

      const setProgress = (pct: number, label?: string) => {
        if (meter) meter.style.width = `${pct}%`;
        if (label && meterTxt) meterTxt.textContent = label;
      };

      const finish = () => {
        if (done) return;
        done = true;
        try {
          sessionStorage.setItem('gl-gate-auth', '1');
        } catch {
          /* 忽略 */
        }
        root.classList.add('gl-authed');
        root.classList.remove('gl-locked');
        setProgress(100, 'ACCESS GRANTED');
        gate.classList.add('is-wipe');

        window.setTimeout(() => {
          gate.classList.add('is-out');
          window.setTimeout(() => {
            gate.remove();
            window.dispatchEvent(new CustomEvent('glimmer:auth'));
          }, reduced ? 60 : 560);
        }, reduced ? 60 : 460);
      };

      const typeLine = (text: string, onDone: () => void) => {
        if (!log) return onDone();
        const row = document.createElement('div');
        log.appendChild(row);

        if (reduced) {
          row.innerHTML = text.replace(/OK/g, '<b>OK</b>');
          onDone();
          return;
        }

        let i = 0;
        const tick = () => {
          row.textContent = text.slice(0, i);
          i += 1;
          if (i <= text.length) {
            window.setTimeout(tick, 8);
          } else {
            row.innerHTML = text.replace(/OK/g, '<b>OK</b>');
            onDone();
          }
        };
        tick();
      };

      const start = () => {
        if (started || done) return;
        started = true;
        if (promptEl) promptEl.style.visibility = 'hidden';
        if (log) log.innerHTML = '';
        meterBar?.classList.add('is-live');
        setProgress(6, 'AUTHENTICATING');

        const seq = lines.length ? lines : ['> 握手完成 OK'];
        let i = 0;
        const next = () => {
          if (i >= seq.length) {
            setProgress(92, 'VERIFYING SIGNATURE');
            window.setTimeout(finish, reduced ? 0 : 420);
            return;
          }
          const line = seq[i++];
          typeLine(line, () => {
            setProgress(8 + (i / seq.length) * 78);
            window.setTimeout(next, reduced ? 0 : 160);
          });
        };
        next();
      };

      // 按任意键 / 点任意处 / 触摸，都开始认证
      window.addEventListener('keydown', (e) => {
        // 允许 F5 / F12 / Tab 等保留浏览器行为
        if (['F5', 'F12', 'Tab'].includes(e.key)) return;
        start();
      });
      gate.addEventListener('click', (e) => {
        if ((e.target as HTMLElement)?.closest('#gl-skip')) return;
        start();
      });
      gate.addEventListener('touchstart', start, { passive: true });
      window.addEventListener('wheel', start, { passive: true, once: true });

      // 跳过按钮
      skip?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        finish();
        window.setTimeout(() => {
          document.getElementById('main')?.scrollIntoView({ block: 'start' });
        }, 120);
      });
    }
  }
</script>
