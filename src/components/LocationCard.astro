---
import { url } from '../lib/site';

interface Props {
  id: string;
  name: string;
  enName?: string;
  type?: string;
  region?: string;
  danger?: string;
  icon?: string;
  accent?: string;
  tags?: string[];
  summary: string;
}

const {
  id,
  name,
  enName,
  type = '地区',
  region,
  danger,
  icon = '◈',
  accent = '#8b5cf6',
  tags = [],
  summary,
} = Astro.props;
---

<a
  href={url(`/settings/locations/${id}`)}
  class="panel hoverable group flex flex-col overflow-hidden p-5"
  style={`--accent:${accent}`}
>
  <div class="flex items-start gap-3">
    <span class="neon-text mt-0.5 shrink-0 font-mono text-xl">{icon}</span>
    <div class="min-w-0 flex-1">
      <h3 class="text-[17px] font-bold leading-tight text-ink transition-colors group-hover:text-[var(--accent)]">
        {name}
      </h3>
      <p class="mt-0.5 truncate font-mono text-[10px] tracking-[0.18em] text-dust-2">
        {enName ?? type}
      </p>
    </div>
    {danger && (
      <span class="chip shrink-0" style={`color:${accent};border-color:${accent}44`}>威胁 {danger}</span>
    )}
  </div>

  <p class="mt-3.5 line-clamp-3 text-[13.5px] leading-relaxed text-dust">{summary}</p>

  <div class="mt-4 flex flex-wrap items-center gap-1.5">
    {region && <span class="chip">{region}</span>}
    {tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
  </div>

  <div class="mt-4 flex items-center justify-end border-t border-edge/70 pt-3">
    <span
      class="font-mono text-[11px] text-dust-2 transition-all duration-300 group-hover:translate-x-1 group-hover:text-[var(--accent)]"
    >
      勘查记录 →
    </span>
  </div>
</a>
