---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CharacterCard from '../../components/CharacterCard.astro';
import Mermaid from '../../components/Mermaid.astro';
import Timeline from '../../components/Timeline.astro';
import { byOrder, url } from '../../lib/site';
import WikiLinks from '../../components/WikiLinks.astro';

export const getStaticPaths = (async () => {
  const factions = await getCollection('factions');
  return factions.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const characters = await getCollection('characters');
const members = characters.filter((c) => c.data.faction === entry.id).sort(byOrder);

const locations = (await getCollection('locations')).filter((l) => l.data.factions.includes(entry.id));

const metaRows = [
  { k: '类型', v: d.type },
  { k: '成立', v: d.founded },
  { k: '首领', v: d.leader },
  { k: '据点', v: d.headquarters },
  { k: '影响力', v: d.influence },
  { k: '状态', v: d.status },
].filter((r) => Boolean(r.v));
---

<BaseLayout
  title={d.name}
  description={d.summary}
  kicker={d.enName ?? 'FACTION FILE'}
  accent={d.accent}
  wikiSelf={`faction:${entry.id}`}
>
  <!-- ============ 头部 ============ -->
  <header class="rise" style={`--accent:${d.accent}`}>
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
      <div
        class="grid h-20 w-20 shrink-0 place-items-center rounded-xl border text-4xl"
        style={`border-color:${d.accent}55;color:${d.accent};background:radial-gradient(circle at 30% 20%, ${d.accent}26, transparent 70%), #0e0e18;box-shadow:0 0 40px -18px ${d.accent}`}
      >
        {d.emblem}
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="text-3xl font-black tracking-tight text-ink sm:text-4xl">{d.name}</h1>
          <span class="chip" style={`color:${d.accent};border-color:${d.accent}55`}>{d.type}</span>
        </div>
        {d.enName && <p class="mt-1 font-mono text-[11px] tracking-[0.22em] text-dust-2">{d.enName}</p>}
        <p class="mt-3 max-w-2xl text-[14.5px] leading-relaxed text-dust">{d.summary}</p>
      </div>
    </div>

    {
      d.motto && (
        <blockquote
          class="mt-7 border-l-2 py-1 pl-4 text-[15px] italic leading-relaxed"
          style={`border-color:${d.accent};color:${d.accent}`}
        >
          「{d.motto}」
        </blockquote>
      )
    }
  </header>

  <!-- ============ 档案信息 ============ -->
  {
    metaRows.length > 0 && (
      <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-edge bg-edge/60 sm:grid-cols-3">
        {metaRows.map((r) => (
          <div class="bg-panel px-4 py-3">
            <dt class="font-mono text-[10px] tracking-[0.2em] text-dust-2">{r.k}</dt>
            <dd class="mt-1 truncate text-[13.5px] text-ink">{r.v}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <!-- ============ 正文 ============ -->
  <div class="prose-oc mt-10">
    <Content />
  </div>

  <!-- ============ 标签 ============ -->
  {
    d.tags.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-1.5">
        {d.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    )
  }

  <!-- ============ 关系图 ============ -->
  {
    d.relations && (
      <SectionHeading title="关系网络" en="RELATIONS" icon="⟠" accent={d.accent} id="relations">
        <Mermaid chart={d.relations} accent={d.accent} />
      </SectionHeading>
    )
  }

  <!-- ============ 成员名册 ============ -->
  {
    members.length > 0 && (
      <SectionHeading title="成员名册" en="MEMBERS" icon="◉" accent={d.accent} id="members">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {members.map((c) => (
            <CharacterCard
              id={c.id}
              name={c.data.name}
              enName={c.data.enName}
              alias={c.data.alias}
              title={c.data.title}
              factionLabel={c.data.factionLabel}
              status={c.data.status}
              avatar={c.data.avatar}
              accent={c.data.accent}
              tags={c.data.tags}
              summary={c.data.summary}
            />
          ))}
        </div>
      </SectionHeading>
    )
  }

  <!-- ============ 活动区域 ============ -->
  {
    locations.length > 0 && (
      <SectionHeading title="活动区域" en="TERRITORY" icon="◈" accent={d.accent} id="territory">
        <div class="flex flex-wrap gap-2.5">
          {locations.map((l) => (
            <a
              href={url(`/settings/locations/${l.id}`)}
              class="panel hoverable px-3.5 py-2.5 text-[13.5px] text-ink"
              style={`--accent:${l.data.accent}`}
            >
              <span class="mr-2 font-mono" style={`color:${l.data.accent}`}>{l.data.icon}</span>
              {l.data.name}
            </a>
          ))}
        </div>
      </SectionHeading>
    )
  }

  <!-- ============ 大事件 ============ -->
  {
    d.events.length > 0 && (
      <SectionHeading title="关键节点" en="TIMELINE" icon="⌛" accent={d.accent} id="timeline">
        <Timeline
          items={d.events.map((e) => ({
            time: e.time,
            title: e.title,
            desc: e.desc,
            accent: d.accent,
          }))}
        />
      </SectionHeading>
    )
  }

  <!-- ============ 反向引用 ============ -->
  <WikiLinks
    kind="faction"
    id={entry.id}
    exclude={[...members.map((m) => `character:${m.id}`), ...locations.map((l) => `location:${l.id}`)]}
  />

  <div class="mt-14 flex flex-wrap gap-3 border-t border-edge pt-6">
    <a href={url('/factions')} class="btn">← 返回势力名录</a>
    <a href={url('/characters')} class="btn">全部人物</a>
  </div>
</BaseLayout>
