---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CharacterCard from '../components/CharacterCard.astro';
import Timeline from '../components/Timeline.astro';
import { byOrder, url } from '../lib/site';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('缺少 src/content/pages/home.md —— 首页文案是必需的。');
const { Content } = await render(home);

const characters = (await getCollection('characters')).sort(byOrder);
const featured = characters.filter((c) => c.data.featured);
const shown = (featured.length ? featured : characters).slice(0, 3);

const factions = (await getCollection('factions')).sort(byOrder);

const events = (await getCollection('timeline')).sort(byOrder);
const recent = events.slice(-3);

const stats = home.data.stats ?? [];
const sections = home.data.sections ?? [];
---

<BaseLayout title="首页" accent={home.data.accent} kicker={home.data.kicker}>
  <!-- ================= HERO ================= -->
  <section class="rise relative">
    <h1
      class="text-[clamp(2.6rem,9vw,5.5rem)] font-black leading-[0.95] tracking-tight text-ink"
      style={`text-shadow:0 0 60px ${home.data.accent}55`}
    >
      {home.data.title}
    </h1>
    {
      home.data.subtitle && (
        <p class="mt-3 font-mono text-sm tracking-[0.3em]" style={`color:${home.data.accent}`}>
          {home.data.subtitle}
        </p>
      )
    }

    {
      home.data.description && (
        <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-dust">{home.data.description}</p>
      )
    }

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={url('/settings')} class="btn">
        <span style={`color:${home.data.accent}`}>▶</span> 进入设定档案
      </a>
      <a href={url('/factions')} class="btn">查看势力格局</a>
    </div>
  </section>

  <!-- ================= 数据条 ================= -->
  {
    stats.length > 0 && (
      <section class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {stats.map((s, i) => (
          <div
            class="panel corners rise px-4 py-4"
            style={`--accent:${home.data.accent};animation-delay:${i * 70}ms`}
          >
            <p class="font-mono text-[10px] tracking-[0.2em] text-dust-2">{s.label}</p>
            <p class="mt-1.5 font-mono text-xl font-bold leading-tight" style={`color:${home.data.accent}`}>
              {s.value}
            </p>
            {s.note && <p class="mt-1 text-[11.5px] leading-snug text-dust-2">{s.note}</p>}
          </div>
        ))}
      </section>
    )
  }

  <!-- ================= 世界观正文 ================= -->
  <SectionHeading title="世界观简介" en="OVERVIEW" icon="◈" accent={home.data.accent} id="overview">
    <div class="prose-oc">
      <Content />
    </div>
  </SectionHeading>

  <!-- ================= 栏目导览 ================= -->
  {
    sections.length > 0 && (
      <SectionHeading title="档案索引" en="INDEX" icon="⌘" accent="#8b5cf6">
        <div class="grid gap-4 sm:grid-cols-3">
          {sections.map((s) => (
            <a
              href={url(s.href)}
              class="panel corners hoverable group flex flex-col p-5"
              style="--accent:#8b5cf6"
            >
              <span class="neon-text font-mono text-lg">{s.icon}</span>
              <h3 class="mt-2.5 text-[16px] font-bold text-ink group-hover:text-[var(--accent)]">
                {s.title}
              </h3>
              <p class="mt-1.5 text-[13px] leading-relaxed text-dust">{s.desc}</p>
              <span class="mt-4 font-mono text-[11px] text-dust-2 transition-transform group-hover:translate-x-1 group-hover:text-[var(--accent)]">
                OPEN →
              </span>
            </a>
          ))}
        </div>
      </SectionHeading>
    )
  }

  <!-- ================= 精选人物 ================= -->
  {
    shown.length > 0 && (
      <SectionHeading title="人物档案" en="DRAMATIS" icon="◉" accent="#00e5ff">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {shown.map((c) => (
            <CharacterCard
              id={c.id}
              name={c.data.name}
              enName={c.data.enName}
              alias={c.data.alias}
              title={c.data.title}
              factionLabel={c.data.factionLabel}
              status={c.data.status}
              avatar={c.data.avatar}
              accent={c.data.accent}
              tags={c.data.tags}
              summary={c.data.summary}
            />
          ))}
        </div>
        <div class="mt-6">
          <a href={url('/characters')} class="btn">全部人物 →</a>
        </div>
      </SectionHeading>
    )
  }

  <!-- ================= 时间轴预览 ================= -->
  {
    recent.length > 0 && (
      <SectionHeading title="编年史" en="CHRONICLE" icon="⌛" accent="#ffb020">
        <Timeline
          items={recent.map((e) => ({
            time: e.data.date,
            title: e.data.title,
            desc: e.data.summary,
            tag: e.data.tag,
            accent: e.data.accent,
          }))}
        />
        <div class="mt-6">
          <a href={url('/settings')} class="btn">完整编年史 →</a>
        </div>
      </SectionHeading>
    )
  }

  <!-- ================= 势力条 ================= -->
  {
    factions.length > 0 && (
      <SectionHeading title="主要势力" en="FACTIONS" icon="⬢" accent="#ff2e97">
        <div class="flex flex-wrap gap-2.5">
          {factions.map((f) => (
            <a
              href={url(`/factions/${f.id}`)}
              class="panel hoverable flex items-center gap-2.5 px-3.5 py-2.5"
              style={`--accent:${f.data.accent}`}
            >
              <span class="font-mono text-sm" style={`color:${f.data.accent}`}>{f.data.emblem}</span>
              <span class="text-[13.5px] text-ink">{f.data.name}</span>
              <span class="font-mono text-[10px] text-dust-2">{f.data.type}</span>
            </a>
          ))}
        </div>
      </SectionHeading>
    )
  }
</BaseLayout>
