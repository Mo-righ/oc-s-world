---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import Timeline from '../../../components/Timeline.astro';
import { url } from '../../../lib/site';
import WikiLinks from '../../../components/WikiLinks.astro';

export const getStaticPaths = (async () => {
  const locations = await getCollection('locations');
  return locations.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const factions = (await getCollection('factions')).filter((f) => d.factions.includes(f.id));
const characters = (await getCollection('characters')).filter((c) => d.characters.includes(c.id));

const metaRows = [
  { k: '类型', v: d.type },
  { k: '所属', v: d.region },
  { k: '气候', v: d.climate },
  { k: '人口', v: d.population },
  { k: '威胁等级', v: d.danger },
].filter((r) => Boolean(r.v));
---

<BaseLayout
  title={d.name}
  description={d.summary}
  kicker={d.enName ?? 'LOCATION FILE'}
  accent={d.accent}
  wikiSelf={`location:${entry.id}`}
>
  <header class="rise" style={`--accent:${d.accent}`}>
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
      <div
        class="grid h-20 w-20 shrink-0 place-items-center rounded-xl border font-mono text-4xl"
        style={`border-color:${d.accent}55;color:${d.accent};background:radial-gradient(circle at 30% 20%, ${d.accent}26, transparent 70%), #0e0e18;box-shadow:0 0 40px -18px ${d.accent}`}
      >
        {d.icon}
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="text-3xl font-black tracking-tight text-ink sm:text-4xl">{d.name}</h1>
          <span class="chip" style={`color:${d.accent};border-color:${d.accent}55`}>{d.type}</span>
          {d.danger && <span class="chip" style="color:#ff4d5e;border-color:#ff4d5e44">威胁 {d.danger}</span>}
        </div>
        {d.enName && <p class="mt-1 font-mono text-[11px] tracking-[0.22em] text-dust-2">{d.enName}</p>}
        <p class="mt-3 max-w-2xl text-[14.5px] leading-relaxed text-dust">{d.summary}</p>
      </div>
    </div>
  </header>

  {
    metaRows.length > 0 && (
      <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-edge bg-edge/60 sm:grid-cols-3">
        {metaRows.map((r) => (
          <div class="bg-panel px-4 py-3">
            <dt class="font-mono text-[10px] tracking-[0.2em] text-dust-2">{r.k}</dt>
            <dd class="mt-1 truncate text-[13.5px] text-ink">{r.v}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <div class="prose-oc mt-10">
    <Content />
  </div>

  {
    d.tags.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-1.5">
        {d.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    )
  }

  {
    factions.length > 0 && (
      <SectionHeading title="此地势力" en="FACTIONS" icon="⬢" accent={d.accent} id="factions">
        <div class="flex flex-wrap gap-2.5">
          {factions.map((f) => (
            <a
              href={url(`/factions/${f.id}`)}
              class="panel hoverable px-3.5 py-2.5 text-[13.5px] text-ink"
              style={`--accent:${f.data.accent}`}
            >
              <span class="mr-2 font-mono" style={`color:${f.data.accent}`}>{f.data.emblem}</span>
              {f.data.name}
            </a>
          ))}
        </div>
      </SectionHeading>
    )
  }

  {
    characters.length > 0 && (
      <SectionHeading title="此地人物" en="PERSONS" icon="◉" accent={d.accent} id="characters">
        <div class="flex flex-wrap gap-2.5">
          {characters.map((c) => (
            <a
              href={url(`/characters/${c.id}`)}
              class="panel hoverable px-3.5 py-2.5 text-[13.5px] text-ink"
              style={`--accent:${c.data.accent}`}
            >
              {c.data.name}
            </a>
          ))}
        </div>
      </SectionHeading>
    )
  }

  {
    d.events.length > 0 && (
      <SectionHeading title="相关事件" en="TIMELINE" icon="⌛" accent={d.accent} id="timeline">
        <Timeline
          items={d.events.map((e) => ({
            time: e.time,
            title: e.title,
            desc: e.desc,
            accent: d.accent,
          }))}
        />
      </SectionHeading>
    )
  }

  <WikiLinks
    kind="location"
    id={entry.id}
    exclude={[...factions.map((f) => `faction:${f.id}`), ...characters.map((c) => `character:${c.id}`)]}
  />

  <div class="mt-14 flex flex-wrap gap-3 border-t border-edge pt-6">
    <a href={url('/settings')} class="btn">← 返回设定总览</a>
  </div>
</BaseLayout>
