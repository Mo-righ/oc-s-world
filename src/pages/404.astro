---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/site';
---

<BaseLayout title="404 · 记录不存在" accent="#ff4d5e" kicker="ERROR 404">
  <div class="flex min-h-[52vh] flex-col justify-center">
    <p class="font-mono text-[clamp(4rem,14vw,9rem)] font-black leading-none text-edge-2 select-none">
      404
    </p>
    <h1 class="mt-2 text-2xl font-bold text-ink">这条记录不在档案里</h1>
    <p class="mt-3 max-w-lg text-[14.5px] leading-relaxed text-dust">
      你打开的那份文件可能是被删除了，也可能是从未存在过。灾后的档案管理一向如此。
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={url('/')} class="btn">
        <span class="text-neon">◀</span> 回到首页
      </a>
      <a href={url('/characters')} class="btn">人物档案</a>
      <a href={url('/settings')} class="btn">设定总览</a>
      <a href={url('/factions')} class="btn">势力格局</a>
    </div>
  </div>
</BaseLayout>
