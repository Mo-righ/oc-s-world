{
  "$ref": "#/definitions/timeline",
  "definitions": {
    "timeline": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "era": {
          "type": "string",
          "default": "陨星纪"
        },
        "title": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "autoLink": {
          "type": "boolean",
          "default": true
        },
        "tag": {
          "type": "string",
          "default": "事件"
        },
        "accent": {
          "type": "string",
          "default": "#00e5ff"
        },
        "summary": {
          "type": "string"
        },
        "order": {
          "type": "number",
          "default": 999
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "title",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}